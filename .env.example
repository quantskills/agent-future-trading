#### Database ####
# Local DB
DB_PATH=assets/agentquant.db

# On-Cloud DB
SUPABASE_URL=your-supabase-url
SUPABASE_KEY=your-supabase-key

#### Offical LLM ####
# Get your OpenAI API key from https://platform.openai.com/
OPENAI_API_KEY=your-openai-api-key

# Get your Anthropic API key from https://anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key

# Deepseek API key from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your-deepseek-api-key

# Qwen API key from https://www.alibabacloud.com/help/en/model-studio/what-is-qwen-llm
QWEN_API_KEY=your-qwen-api-key

# Zhipu API key from https://open.bigmodel.cn/
ZHIPU_API_KEY=your-zhipu-api-key

#### Backup third-party multi-model LLM gateway (TQX) ####
# TQX is retained as a backup third-party LLM provider interface.
# Current AgentQuant main route is CodexOpenAI gpt-5.5 via CODEX_OPENAI_API_KEY below.
# Claude Opus is callable through TQX, but OpenAI reasoning_effort low/medium/high
# is not accepted on this gateway, so the TQX block remains inactive in dev.yaml.
TQX_LLM_API_KEY=your-tqx-third-party-api-key
TQX_LLM_BASE_URL=https://llm.tqx.ai
TQX_LLM_MODEL=claude-opus-4-6-1
TQX_LLM_REASONING_EFFORT=

#### Active CodexOpenAI GPT-5.5 gateway ####
# Current AgentQuant LLM route uses http://47.74.0.65 and CODEX_OPENAI_API_KEY.
# dev.yaml keeps base_url as http://47.74.0.65; runtime normalizes it to /v1.
# Active route: provider=CodexOpenAI, model=gpt-5.5, reasoning_effort=medium.
CODEX_OPENAI_API_KEY=your-codex-openai-api-key
CODEX_OPENAI_BASE_URL=http://47.74.0.65
CODEX_OPENAI_MODEL=gpt-5.5

# Get your Yi-Zhan API key from https://vip.yi-zhan.top/
YIZHAN_API_KEY=your-yizhan-api-key

# AiHubMix API key from https://aihubmix.com/
AIHUBMIX_API_KEY=your-aihubmix-api-key

# See available models in https://fireworks.ai/models
FIREWORKS_API_KEY=your-fireworks-api-key

#### Financial data provider ####
# Alpha Vantage API key from https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key

# DataYes API key from https://uqer.datayes.com/
# Legacy fallback for Chinese futures market data
DATAYES_API_KEY=your-datayes-api-key

# PandaAI API key from https://www.pandaai.online/
PANDAAI_USERNAME=your-pandaai-username
PANDAAI_PASSWORD=your-pandaai-password

